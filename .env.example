# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/ogcut"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"

# --- Server ---
PORT=3001

# Where the frontend runs — used to redirect the browser back after a
# Google/Facebook login completes.
FRONTEND_URL="http://localhost:3000"

# --- Google OAuth (optional — sign-in buttons work once these are set) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# and add GOOGLE_CALLBACK_URL as an authorized redirect URI there.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# --- Facebook OAuth (optional — sign-in buttons work once these are set) ---
# Create an app at https://developers.facebook.com/apps and add
# FACEBOOK_CALLBACK_URL as a valid OAuth redirect URI there.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_CALLBACK_URL="http://localhost:3001/api/auth/facebook/callback"

# --- Supabase (server-side image uploads, if used) ---
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Razorpay ---
# Use your TEST MODE keys from the Razorpay dashboard (Settings > API Keys)
# to run payments in mock/sandbox mode — test cards and UPI IDs complete
# instantly without moving real money. NEXT_PUBLIC_RAZORPAY_KEY_ID must be
# the *same* key id set in the frontend's .env.local.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
