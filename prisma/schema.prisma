generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// USER & ADDRESS MANAGEMENT
// ==========================================

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String
  firstName     String  
  lastName      String?
  role          Role     @default(CUSTOMER)
  phone         String?
  createdAt     DateTime @default(now())
  isActive      Boolean  @default(true) 

  addresses Address[]
  orders    Order[]

  @@map("user")
}

model Address {
  id        Int     @id @default(autoincrement())
  uid       Int
  label     String
  fullName  String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  phone     String
  createdAt DateTime @default(now()) @map("created_at")
  
  user User @relation(fields: [uid], references: [id], onDelete: Cascade)

  @@map("address")
}

enum Role {
  CUSTOMER
  ADMIN
}

// ==========================================
// PRODUCT CATALOG & MEDIA
// ==========================================

model Product {
  id        Int           @id @default(autoincrement())
  name      String
  desc      String        @db.Text
  price     Decimal       @db.Decimal(10, 2)
  type      ProductType   @default(STANDARD)
  isActive  Boolean       @default(true) 

  images     ProductImage[]
  orderItems OrderItem[]

  @@map("product")
}

model ProductImage {
  id         Int    @id @default(autoincrement())
  pid        Int
  imgurl     String
  sortWeight Int    @default(0)

  product Product @relation(fields: [pid], references: [id], onDelete: Cascade)

  @@map("product_images")
}

enum ProductType {
  STANDARD
  CUSTOMIZABLE
}

// ==========================================
// ORDER & FULFILLMENT ARCHITECTURE
// ==========================================

model Order {
  id             Int         @id @default(autoincrement())
  orderCode      String      @unique // Public URL reference (e.g. ORD-8F3K9A)
  uid            Int
  address        Json
  coupon         String?
  status         OrderStatus @default(PENDING)
  totalAmount    Decimal     @db.Decimal(10, 2)
  trackingNumber String?
  createdAt      DateTime    @default(now())
  paymentStatus  PaymentStatus? @default(UNPAID)

  user  User        @relation(fields: [uid], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@map("order")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  oid       Int
  pid       Int
  quantity  Int     @default(1)
  size      String
  color     String? @db.VarChar(50)
  unitPrice Decimal @db.Decimal(10, 2)

  order      Order             @relation(fields: [oid], references: [id], onDelete: Restrict)
  product    Product           @relation(fields: [pid], references: [id], onDelete: Restrict)
  placements CustomPlacement[]

  @@map("order_item")
}

model CustomPlacement {
  id     Int           @id @default(autoincrement())
  oiid   Int
  place  PlacementZone
  xvalue Float
  yvalue Float
  zoom   Float         @default(1.0)
  imgurl String
  height Float?
  width  Float?

  orderItem OrderItem @relation(fields: [oiid], references: [id], onDelete: Restrict)

  @@index([oiid])
  @@map("custom_placements")
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum OrderStatus {
  PENDING
  PROCESSING
  PRINTING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PlacementZone {
  front
  back
  left
  right
}