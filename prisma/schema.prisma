// schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Product {
  id           Int           @id @default(autoincrement())
  name         String
  description  String
  price        Decimal       @db.Decimal(10, 2)
  images       String[]
  inventory    Int           @default(0)

  // 3D graphic vs 2D photo fields
  designType   String        @default("graphic_only")
  graphicUrl   String?
  mockupUrl    String?
  targetZone   String        @default("front")

  categoryId   Int
  category     Category      @relation(fields: [categoryId], references: [id])
  savedDesigns SavedDesign[]
  orderItems   OrderItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PageConfig {
  id           Int      @id @default(autoincrement())
  themeColors  String?  @db.Text
  sectionOrder String?  @db.Text
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  password_hash String
  first_name    String?
  last_name     String?
  role          Role          @default(CUSTOMER)
  saved_designs SavedDesign[]
  page_views    PageView[]
  addresses     Address[]
  designs       Design[]      // Community & user-created designs
  orders        Order[]       // Customer order history
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}

model SavedDesign {
  id         String   @id @default(uuid())
  user_id    String
  product_id Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@unique([user_id, product_id])
}

model PageView {
  id               String   @id @default(uuid())
  user_id          String?
  session_id       String
  page_path        String
  duration_seconds Int      @default(0)
  created_at       DateTime @default(now())
  user             User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
}

enum Role {
  CUSTOMER
  ADMIN
}

// ==========================================
// NEW MODELS: MARKETPLACE & PRINT ORDERS
// ==========================================

model Design {
  id           String      @id @default(uuid())
  title        String      @default("Untitled Design")
  imageUrl     String      // High-res asset URL (Cloudinary)
  publicId     String?     // Cloudinary Asset ID

  authorId     String?
  author       User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  isPublic     Boolean     @default(true) // Allows other users to pick this design in the 3D studio
  category     String?     @default("General")
  tags         String[]

  // Preset calibrations for the 3D studio
  defaultZone  String      @default("front")
  customWidth  Float
  customHeight Float

  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Order {
  id          String      @id @default(uuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  addressId   String?
  address     Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)

  status      OrderStatus @default(PENDING)
  fabricColor String
  total       Decimal     @db.Decimal(10, 2)

  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model CustomShirtOrder {
  id          String         @id @default(uuid())
  fabricColor String
  placements  DesignPlacement[]
  createdAt   DateTime       @default(now())
}

model DesignPlacement {
  id          String           @id @default(uuid())
  orderId     String
  order       CustomShirtOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  zone        String           // 'front' | 'back' | 'leftSleeve' | 'rightSleeve'
  imageUrl    String           // Public storage URL
  x           Float
  y           Float
  scale       Float
  width       Float
  height      Float
  centerX     Float
  centerY     Float
  clipWidth   Float
  clipHeight  Float

  @@index([orderId])
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId    Int?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  designId     String?
  design       Design?  @relation(fields: [designId], references: [id], onDelete: SetNull)

  // Print execution coordinates & asset reference
  zone         String   // 'front' | 'back' | 'leftSleeve' | 'rightSleeve'
  imageUrl     String

  // UV Base Print Area Calibration
  clipX        Float
  clipY        Float
  clipWidth    Float
  clipHeight   Float

  // User Custom Transformation
  offsetX      Float
  offsetY      Float
  scale        Float
  customWidth  Float
  customHeight Float

  createdAt    DateTime @default(now())
}

enum OrderStatus {
  PENDING
  PROCESSING
  PRINTING
  SHIPPED
  DELIVERED
  CANCELLED
}